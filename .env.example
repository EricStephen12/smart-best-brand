# =============================================================================
# SMART BEST BRANDS - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

# Database (PostgreSQL - Neon / Supabase / AWS RDS)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# App Public URL (used for canonical links, sitemaps, emails, recovery links)
NEXT_PUBLIC_APP_URL="https://smartbestbrands.com"

# Authentication & Session Security (Generate with: openssl rand -base64 32)
AUTH_SECRET="your-32-character-random-secret-key-here"

# Cron Job Security (Protects /api/cron/abandoned-carts from unauthorized triggers)
CRON_SECRET="your-random-cron-secret-token"

# Paystack Payment Gateway (Get from: https://dashboard.paystack.com/#/settings/developer)
# Use pk_live_ and sk_live_ in production
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""

# Resend Email Service (Get from: https://resend.com/api-keys)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Smart Best Brands <orders@smartbestbrands.com>"
CONTACT_NOTIFY_EMAIL="admin@smartbestbrands.com"

# WhatsApp & Customer Care Phone Numbers (Include country code, no + or spaces for WhatsApp)
NEXT_PUBLIC_WHATSAPP_NUMBER="2348064619479"
NEXT_PUBLIC_SUPPORT_PHONE="+234 806 461 9479"

# Cloudinary Media Storage (For product image uploads in admin backoffice)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-unsigned-upload-preset"

# Optional n8n Workflow Webhooks
N8N_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""
