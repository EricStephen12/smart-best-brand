# Database (Prisma)
DATABASE_URL=
DIRECT_URL=

# Clerk Auth (passwords/sessions live in Clerk — not in our DB)
# Dashboard: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/account
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/account

# Paystack — use TEST keys locally; PRODUCTION keys only on the live host
# Dashboard: https://dashboard.paystack.com/#/settings/developer
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

# Webhook URL to register in Paystack Dashboard → Settings → API Keys & Webhooks:
# Prefer the Glow Dental hub (one Paystack field for both sites):
#   https://denpointment-theta.vercel.app/api/webhooks/paystack
# That hub forwards ORD-* here. Direct URL (if clinic hub is not used):
#   https://YOUR_DOMAIN/api/webhooks/paystack
# Use the same secret key mode (test vs live) as the keys above.

# WhatsApp / phone (no fake fallbacks in UI — leave empty to hide CTAs)
NEXT_PUBLIC_WHATSAPP_NUMBER=234xxxxxxxxxx
NEXT_PUBLIC_SUPPORT_PHONE=+234xxxxxxxxxx

# Optional integrations
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_NOTIFY_EMAIL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
USE_MOCK_DATA=false
