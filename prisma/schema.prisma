generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String   @id @default(uuid())
  clerkId          String?  @unique
  name             String?
  email            String   @unique
  phone            String?
  deliveryAddress  String?
  deliveryLocation String?
  passwordHash     String?
  role             Role     @default(CUSTOMER)
  createdAt        DateTime @default(now())
  orders           Order[]
  reviews          Review[]
  carts            Cart[]

  @@index([clerkId])
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  logoUrl   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]

  @@index([slug])
  @@index([isActive])
}

model Category {
  id         String              @id @default(uuid())
  name       String              @unique
  slug       String              @unique
  createdAt  DateTime            @default(now())
  products   ProductCategory[]
  promotions PromotionCategory[]

  @@index([slug])
}

model Size {
  id       String           @id @default(uuid())
  label    String           @unique
  width    Float?
  length   Float?
  variants ProductVariant[]

  @@index([label])
}

model Product {
  id           String             @id @default(uuid())
  name         String
  slug         String             @unique
  description  String?
  brandId      String
  type         String?
  materials    String?
  firmness     String?
  finishing    String?
  features     String[]
  isNegotiable Boolean            @default(false)
  warranty     String?
  images       String[]
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  brand        Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  categories   ProductCategory[]
  variants     ProductVariant[]
  promotions   PromotionProduct[]
  reviews      Review[]

  @@index([slug])
  @@index([brandId])
  @@index([isActive])
  @@index([createdAt])
}

model ProductVariant {
  id         String      @id @default(uuid())
  productId  String
  sizeId     String
  price      Float
  promoPrice Float?
  stock      Int         @default(0)
  sku        String?     @unique
  isActive   Boolean     @default(true)
  orderItems OrderItem[]
  cartItems  CartItem[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       Size        @relation(fields: [sizeId], references: [id])

  @@index([productId])
  @@index([sizeId])
  @@index([sku])
}

model ProductCategory {
  productId  String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
}

model Order {
  id                  String      @id @default(uuid())
  orderNumber         String      @unique
  idempotencyKey      String?     @unique
  userId              String?
  customerName        String
  customerEmail       String
  customerPhone       String
  deliveryAddress     String
  deliveryLocation    String
  deliveryFee         Float
  subtotal            Float
  total               Float
  discount            Float       @default(0)
  promoCode           String?
  status              OrderStatus @default(PENDING)
  paymentMethod       String
  paymentReference    String?
  inventoryDeductedAt DateTime?
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  user                User?       @relation(fields: [userId], references: [id])
  items               OrderItem[]

  @@index([orderNumber])
  @@index([idempotencyKey])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String         @id @default(uuid())
  orderId   String
  variantId String
  quantity  Int
  price     Float
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

model DeliveryLocation {
  id        String   @id @default(uuid())
  name      String   @unique
  basePrice Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive])
}

model Promotion {
  id                   String              @id @default(uuid())
  title                String
  description          String?
  code                 String?             @unique
  discountType         String
  discountValue        Float
  minPurchase          Float?
  maxDiscount          Float?
  maxUses              Int?
  usedCount            Int                 @default(0)
  singleUsePerCustomer Boolean             @default(false)
  startDate            DateTime?
  endDate              DateTime?
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  appliesTo            String              @default("ALL")
  categories           PromotionCategory[]
  products             PromotionProduct[]

  @@index([code])
  @@index([isActive])
}

model PromotionProduct {
  promotionId String
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([promotionId])
  @@index([productId])
}

model PromotionCategory {
  promotionId String
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@index([promotionId])
  @@index([categoryId])
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  subtitle  String?
  imageUrl  String
  ctaLabel  String?
  ctaHref   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([isActive])
  @@index([sortOrder])
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  userId     String?
  authorName String
  rating     Int
  title      String?
  body       String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([productId, userId])
  @@index([productId])
  @@index([isApproved])
  @@index([createdAt])
}

model ContactInquiry {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String?
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Singleton row (id = "default") for no-code site content & theme
model SiteSettings {
  id                   String   @id @default("default")
  siteName             String   @default("Smart Best Brands")
  tagline              String   @default("Quality mattresses, pillows & furniture")
  logoUrl              String?
  primaryColor         String   @default("#172554")
  accentColor          String   @default("#0284c7")
  backgroundColor      String   @default("#f7f6f3")
  
  // Announcement Bar
  announcementEnabled  Boolean  @default(false)
  announcementText     String?  @default("Original Nigerian mattresses & furniture — fast delivery to your door.")
  announcementLink     String?  @default("/products")

  // Hero Section
  heroTitle            String   @default("Quality mattresses, pillows & furniture")
  heroSubtitle         String   @default("Authentic comfort for Nigerian homes — shop trusted brands with clear pricing and delivery.")
  heroCtaLabel         String   @default("Shop products")
  heroCtaHref          String   @default("/products")

  // Story Section (Who We Are)
  storyBadge           String   @default("Who We Are")
  storyTitle           String   @default("Original Mattresses, Directly to Your Home.")
  storyText            String   @default("We started Smart Best Brands to make buying genuine mattresses simple in Nigeria. No fake foam, no hidden fees—just original brands like Mouka, Vitafoam, and Royal Foam delivered directly to your doorstep.")
  storySecondaryBadge  String   @default("Our Promise")
  storySecondaryTitle  String   @default("100% Authentic, Direct From the Factory.")
  storySecondaryText   String   @default("We source directly from authorized factory distributors so you never have to worry about counterfeits. Every mattress comes in its original factory packaging with a real manufacturer warranty.")
  storyImageUrl        String?

  // Mid-Page Promo Banner
  promoBadge           String   @default("For Nigerian homes")
  promoTitle           String   @default("Comfort that feels like home")
  promoCtaLabel        String   @default("Discover now")
  promoCtaHref         String   @default("/products")
  promoImageUrl        String?

  // Contact, Location & Socials
  storeAddress         String   @default("Abuja · Benin City")
  contactEmail         String   @default("hello@smartbestbrands.com")
  whatsappNumber       String?
  supportPhone         String?
  instagramUrl         String?  @default("https://instagram.com/smartbestbrands")
  facebookUrl          String?
  twitterUrl           String?
  tiktokUrl            String?

  // Footer & Legal
  footerText           String   @default("Authentic comfort for Nigerian homes. Quality mattresses, pillows, and furniture from trusted brands.")
  updatedAt            DateTime @updatedAt
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model WebhookEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique
  eventType String
  createdAt DateTime @default(now())

  @@index([eventId])
}

model Cart {
  id                       String     @id @default(uuid())
  userId                   String?
  guestToken               String?    @unique
  email                    String?
  phone                    String?
  recoveryToken            String?    @unique
  lastAbandonedEmailSentAt DateTime?
  isRecovered              Boolean    @default(false)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  user                     User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items                    CartItem[]

  @@index([userId])
  @@index([guestToken])
  @@index([recoveryToken])
  @@index([updatedAt])
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  variantId String
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

